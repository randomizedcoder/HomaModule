From 42b3bb93b4472ba48e15d596a8a833d9829f9ddb Mon Sep 17 00:00:00 2001
From: "randomizedcoder dave.seddon.ca@gmail.com" <dave.seddon.ca@gmail.com>
Date: Wed, 21 Oct 2026 23:34:06 -0700
Subject: [PATCH] Build on Linux 7.1 and later

Linux 7.1 changed two APIs that Homa uses:

* proto.recvmsg lost its addr_len argument (8341c989ac77, "net: remove
  addr_len argument of recvmsg() handlers"); handlers now set
  msg->msg_namelen themselves. Add a small adapter, homa_recvmsg_proto,
  that does what sock_common_recvmsg used to do, so homa_recvmsg and its
  unit tests are unchanged.
* net_hotdata.rps_sock_flow_table became an rps_tag_ptr (dd378109d20f,
  "net-sysfs: use rps_tag_ptr and remove metadata from
  rps_sock_flow_table"). Use rps_tag_to_table/rps_tag_to_mask in
  homa_set_softirq_cpu, mirroring rps_record_sock_flow.

Builds against 6.12, 6.19, 7.2.9, 7.3-rc6 and 7.3; unit tests pass.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 homa_impl.h     |  5 +++++
 homa_offload.c  | 18 ++++++++++++++++++
 homa_plumbing.c | 31 +++++++++++++++++++++++++++++--
 3 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/homa_impl.h b/homa_impl.h
index 343eab3..f6b477f 100644
--- a/homa_impl.h
+++ b/homa_impl.h
@@ -99,6 +99,11 @@ struct homa_sock;
 #define SOCKADDR sockaddr
 #endif
 
+/* Linux 7.1 removed the addr_len argument from proto.recvmsg. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+#define HOMA_RECVMSG_NO_ADDR_LEN
+#endif
+
 /**
  * union sockaddr_in_union - Holds either an IPv4 or IPv6 address (smaller
  * and easier to use than sockaddr_storage).
diff --git a/homa_offload.c b/homa_offload.c
index 73e5d89..62ecd93 100644
--- a/homa_offload.c
+++ b/homa_offload.c
@@ -76,6 +76,23 @@ int homa_offload_end(void)
  */
 void homa_set_softirq_cpu(struct sk_buff *skb, int cpu)
 {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+	struct rps_sock_flow_table *table;
+	rps_tag_ptr tag_ptr;
+	u32 hash, index;
+
+	rcu_read_lock();
+	tag_ptr = READ_ONCE(net_hotdata.rps_sock_flow_table);
+	if (tag_ptr) {
+		table = rps_tag_to_table(tag_ptr);
+		hash = cpu + net_hotdata.rps_cpu_mask + 1;
+		index = hash & rps_tag_to_mask(tag_ptr);
+		if (READ_ONCE(table[index].ent) != hash)
+			WRITE_ONCE(table[index].ent, hash);
+		__skb_set_sw_hash(skb, hash, false);
+	}
+	rcu_read_unlock();
+#else
 	struct rps_sock_flow_table *sock_flow_table;
 	u32 hash, index;
 
@@ -89,6 +106,7 @@ void homa_set_softirq_cpu(struct sk_buff *skb, int cpu)
 		__skb_set_sw_hash(skb, hash, false);
 	}
 	rcu_read_unlock();
+#endif
 }
 
 /**
diff --git a/homa_plumbing.c b/homa_plumbing.c
index 4756497..bc50b31 100644
--- a/homa_plumbing.c
+++ b/homa_plumbing.c
@@ -82,6 +82,33 @@ static const struct proto_ops homav6_proto_ops = {
 	.set_peek_off	   = sk_set_peek_off,
 };
 
+#ifdef HOMA_RECVMSG_NO_ADDR_LEN
+/**
+ * homa_recvmsg_proto() - Adapts homa_recvmsg to kernels where
+ * proto.recvmsg has no addr_len argument: the handler must set
+ * msg->msg_namelen itself.
+ * @sk:      Socket on which the system call was invoked.
+ * @msg:     Controlling information for the receive.
+ * @len:     Total bytes of space available in msg->msg_iov.
+ * @flags:   Flags from system call.
+ * Return:   Same as homa_recvmsg.
+ */
+static int homa_recvmsg_proto(struct sock *sk, struct msghdr *msg,
+			      size_t len, int flags)
+{
+	int addr_len = 0;
+	int result;
+
+	result = homa_recvmsg(sk, msg, len, flags, &addr_len);
+	if (result >= 0)
+		msg->msg_namelen = addr_len;
+	return result;
+}
+#define HOMA_PROTO_RECVMSG homa_recvmsg_proto
+#else
+#define HOMA_PROTO_RECVMSG homa_recvmsg
+#endif
+
 /* This structure also defines functions that handle various operations
  * on Homa sockets. However, these functions are lower-level than those
  * in homa_proto_ops: they are specific to the PF_INET or PF_INET6
@@ -98,7 +125,7 @@ static struct proto homa_prot = {
 	.setsockopt	   = homa_setsockopt,
 	.getsockopt	   = homa_getsockopt,
 	.sendmsg	   = homa_sendmsg,
-	.recvmsg	   = homa_recvmsg,
+	.recvmsg	   = HOMA_PROTO_RECVMSG,
 	.hash		   = homa_hash,
 	.unhash		   = homa_unhash,
 	.obj_size	   = sizeof(struct homa_sock),
@@ -115,7 +142,7 @@ static struct proto homav6_prot = {
 	.setsockopt	   = homa_setsockopt,
 	.getsockopt	   = homa_getsockopt,
 	.sendmsg	   = homa_sendmsg,
-	.recvmsg	   = homa_recvmsg,
+	.recvmsg	   = HOMA_PROTO_RECVMSG,
 	.hash		   = homa_hash,
 	.unhash		   = homa_unhash,
 	.obj_size	   = sizeof(struct homa_v6_sock),
-- 
2.55.0

