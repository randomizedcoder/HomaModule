# style.test --
#
#	Checks the package's sources against the Tcl Engineering Manual's
#	conventions this package keeps: every procedure, method and constructor
#	has a header with Arguments: (when it takes any), Results: and Side
#	effects:, and nothing uses eval or exports with a pattern. Every row is
#	{description category input outcome expected}; see testTable in
#	helpers.tcl.

source [file join [file dirname [info script]] helpers.tcl]

# headerGaps --
#
#	Finds the procedures, methods and constructors whose header comment
#	lacks a section. The header is the block of comment lines just above
#	the declaration (blank lines between them are allowed).
#
# Arguments:
#	text	Tcl source.
#
# Results:
#	The names of the commands with a gap, in order ("constructor" for a
#	constructor), or an empty list.
#
# Side effects:
#	None.

proc headerGaps {text} {
    set lines [split $text \n]
    set gaps {}
    for {set i 0} {$i < [llength $lines]} {incr i} {
        set decl [string trim [lindex $lines $i]]
        if {![regexp {^(proc|method|constructor)\s} $decl]} {
            continue
        }
        # Without the body's opening brace, the declaration is a list.
        if {[string index $decl end] eq "\{"} {
            set decl [string range $decl 0 end-1]
        }
        if {[catch {llength $decl}]} {
            continue
        }
        if {[lindex $decl 0] eq "constructor"} {
            lassign [list constructor [lindex $decl 1]] name params
        } else {
            lassign [lrange $decl 1 2] name params
        }
        set j [expr {$i - 1}]
        while {$j >= 0 && [string trim [lindex $lines $j]] eq ""} {
            incr j -1
        }
        set header {}
        while {$j >= 0 && [regexp {^\s*#} [lindex $lines $j]]} {
            set header "[lindex $lines $j]\n$header"
            incr j -1
        }
        set want {Results: {Side effects:}}
        if {[llength $params]} {
            lappend want Arguments:
        }
        foreach section $want {
            if {![regexp -line "^\\s*#\\s*$section" $header]} {
                lappend gaps $name
                break
            }
        }
    }
    return $gaps
}

# banned --
#
#	Finds the constructs this package does not use, outside comments: eval
#	(build a list and run it, or use uplevel or tailcall) and "namespace
#	export *" (name each public command).
#
# Arguments:
#	text	Tcl source.
#
# Results:
#	A list with one entry per use: "eval" or "export *".
#
# Side effects:
#	None.

proc banned {text} {
    set found {}
    foreach line [split $text \n] {
        if {[regexp {^\s*#} $line]} {
            continue
        }
        # namespace eval runs a script in a namespace; it builds nothing.
        regsub -all {namespace\s+eval\s} $line {} line
        foreach match [regexp -all -inline {(?:^|[\s\[;\{])eval\s} $line] {
            lappend found eval
        }
        if {[regexp {namespace\s+export\s+.*\*} $line]} {
            lappend found {export *}
        }
    }
    return $found
}

testTable headerGaps {
    {"a full header" positive {
# foo --
#
#	Does foo.
#
# Arguments:
#	x	a value.
#
# Results:
#	None.
#
# Side effects:
#	None.

proc foo {x} {}
} ok {}}
    {"no arguments, no Arguments: section needed" positive {
# foo --
#
# Results:
#	1.
#
# Side effects:
#	None.

proc foo {} {return 1}
} ok {}}
    {"no Side effects: section" negative {
# foo --
#
# Arguments:
#	x	a value.
#
# Results:
#	None.

proc foo {x} {}
} ok foo}
    {"arguments but no Arguments: section" negative {
# foo --
#
# Results:
#	None.
#
# Side effects:
#	None.

proc foo {x {y 1}} {}
} ok foo}
    {"no header at all" negative {proc foo {} {}} ok foo}
    {"methods and a constructor, indented, in a class" corner {
oo::class create C {
    # constructor --
    #
    # Arguments:
    #	x	a value.
    #
    # Side effects:
    #	Sets x.

    constructor {x} {
    }

    # get --
    #
    # Results:
    #	x.
    #
    # Side effects:
    #	None.

    method get {} {
    }
}
} ok constructor}
    {"only the block just above counts: the next proc's is its own" corner {
# a --
#
# Results:
#	None.
#
# Side effects:
#	None.

proc a {} {}
proc b {} {}
} ok b}
    {"a declaration in a comment is not one" corner {# proc foo {} {}} ok {}}
    {"an empty file" boundary {} ok {}}
} {
    headerGaps $input
}

testTable banned {
    {"eval as a command" negative {eval $cmd} ok eval}
    {"eval in a substitution" negative {set x [eval $cmd]} ok eval}
    {"a pattern export" negative {namespace export *} ok {{export *}}}
    {"uplevel with a list is fine" positive {uplevel 1 [list expr $c]} ok {}}
    {"eval in a comment is not a use" corner {# never eval a string} ok {}}
    {"namespace eval is not eval" corner {namespace eval ::a {variable x}} ok {}}
    {"but eval inside namespace eval is" negative {namespace eval ::a {eval $s}} ok eval}
    {"a word that starts with eval is not eval" boundary {set evaluated 1} ok {}}
    {"an explicit export list" positive {namespace export wrap line} ok {}}
    {"an empty file" boundary {} ok {}}
} {
    banned $input
}

# Every source file: {headerGaps banned}, both empty.
testTable sources {
    {"parse.tcl" positive parse.tcl ok {{} {}}}
    {"protocol.tcl" positive protocol.tcl ok {{} {}}}
    {"report.tcl" positive report.tcl ok {{} {}}}
    {"console.tcl" positive console.tcl ok {{} {}}}
    {"lc.tcl" positive lc.tcl ok {{} {}}}
    {"bin/lifecycle.tcl" positive bin/lifecycle.tcl ok {{} {}}}
    {"bin/pair-lifecycle.tcl" positive bin/pair-lifecycle.tcl ok {{} {}}}
    {"bin/vm-matrix.tcl" positive bin/vm-matrix.tcl ok {{} {}}}
} {
    set chan [open [file join [file dirname $::here] $input]]
    try {
        chan configure $chan -encoding utf-8
        set text [read $chan]
    } finally {
        close $chan
    }
    list [headerGaps $text] [banned $text]
}

tcltest::cleanupTests
