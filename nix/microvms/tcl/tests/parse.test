# parse.test --
#
#	Table-driven tests for homa::lc::parse, the pure functions behind the
#	lifecycle drivers. Every row is {description category input outcome
#	expected}; see testTable in helpers.tcl.

source [file join [file dirname [info script]] helpers.tcl]

# ---- Text ------------------------------------------------------------------

testTable firstLine {
    {"first of several lines" positive "one\ntwo\n" ok one}
    {"a single line without newline" boundary one ok one}
    {"empty text" boundary {} ok {}}
    {"a leading empty line counts" corner "\nsecond" ok {}}
} {parse firstLine $input}

testTable lines {
    {"one entry per line" positive "a\nb\n" ok {a b}}
    {"no final newline" positive "a\nb" ok {a b}}
    {"empty text has no lines" boundary {} ok {}}
    {"a blank line in the middle is kept" corner "a\n\nb" ok {a {} b}}
    {"only newlines" corner "\n\n" ok {}}
} {parse lines $input}

testTable lastLine {
    {"last of several lines" positive "one\ntwo\n" ok two}
    {"trailing empty lines are skipped" corner "one\ntwo\n\n\n" ok two}
    {"a single line" boundary one ok one}
    {"empty text" boundary {} ok {}}
    {"only newlines" corner "\n\n" ok {}}
} {parse lastLine $input}

# ---- Guest output ----------------------------------------------------------

testTable firstKernelLine {
    {"a printk timestamp" positive "\[    2.179107\] Linux version" ok {[    2.179107]}}
    {"firmware noise before the kernel" corner "SeaBIOS\n\[    0.000000\] x" ok {[    0.000000]}}
    {"no kernel line yet" negative "SeaBIOS (version 1.16)\n" ok {}}
    {"empty serial log" boundary {} ok {}}
    {"a timestamp not at the start of a line" corner "x \[ 1.0\] y" ok {}}
} {parse firstKernelLine $input}

testTable oops {
    {"a clean dmesg" positive "homa: loaded\nhoma: unloaded\n" ok {}}
    {"a BUG" negative "ok\nBUG: unable to handle page fault\nok" ok
        {{BUG: unable to handle page fault}}}
    {"a WARNING and a KASAN report" negative "WARNING: CPU: 1 PID: 9\nKASAN: use-after-free" ok
        {{WARNING: CPU: 1 PID: 9} {KASAN: use-after-free}}}
    {"a general protection fault" negative "Oops: general protection fault" ok
        {{Oops: general protection fault}}}
    {"lower-case warning is not an oops" corner "warning: something benign" ok {}}
    {"WARNING without a colon is not an oops" corner "WARNING something" ok {}}
    {"empty text" boundary {} ok {}}
} {parse oops $input}

testTable oopsAlso {
    {"the RIP line comes with its oops, in order" positive
        {"BUG: x\nCPU: 1\nRIP: 0010:homa_peer_free\nok" RIP:} ok
        {{BUG: x} {RIP: 0010:homa_peer_free}}}
    {"a RIP line alone is still returned" corner {"RIP: 0010:f" RIP:} ok {{RIP: 0010:f}}}
    {"an empty extra pattern adds nothing" boundary {"RIP: 0010:f" {}} ok {}}
    {"a bad extra pattern is an error" negative {"x" (} errorGlob
        {* compile regular expression pattern: parentheses () not balanced}}
} {parse oops {*}$input}

testTable smokeDetail {
    {"a pass" positive {"HOMA_SMOKE_INSMOD_OK\nHOMA_SMOKE_PASS" 0} ok HOMA_SMOKE_PASS}
    {"a failure names its step" negative {"HOMA_SMOKE_INSMOD_OK\nHOMA_SMOKE_FAIL:ECHO" 1} ok
        HOMA_SMOKE_FAIL:ECHO}
    {"the last verdict wins" corner {"HOMA_SMOKE_FAIL:ECHO\nHOMA_SMOKE_PASS" 0} ok HOMA_SMOKE_PASS}
    {"no verdict: the last step reached" negative
        {"HOMA_SMOKE_INSMOD_OK\nHOMA_SMOKE_ECHO_OK" 124} ok
        {no verdict (rc 124), last step: HOMA_SMOKE_ECHO_OK}}
    {"no output at all" boundary {{} 125} ok {no verdict (rc 125), last step: }}
} {parse smokeDetail {*}$input}

testTable countLines {
    {"counts matching lines" positive {{^cycle .* ok} "cycle 1 ok\ncycle 2 ok\n"} ok 2}
    {"no match" negative {{^cycle .* ok} "insmod: error\n"} ok 0}
    {"empty text" boundary {{^cycle .* ok} {}} ok 0}
    {"a match must be anchored per line" corner {{^cycle .* ok} "x cycle 1 ok"} ok 0}
} {parse countLines {*}$input}

# ---- Counters ----------------------------------------------------------------

set keys {packets_sent_DATA eth1_rx_packets rpc_timeouts}

testTable snap [list \
    [list "per-core lines are summed" positive \
        [list "packets_sent_DATA 10 sent\npackets_sent_DATA 5 sent\neth1_rx_packets 7" $keys] ok \
        {packets_sent_DATA 15 eth1_rx_packets 7 rpc_timeouts 0}] \
    [list "other counters are ignored" positive \
        [list "unknown_rpcs 9\npackets_sent_DATA 1" $keys] ok \
        {packets_sent_DATA 1 eth1_rx_packets 0 rpc_timeouts 0}] \
    [list "no input gives zeros" boundary [list {} $keys] ok \
        {packets_sent_DATA 0 eth1_rx_packets 0 rpc_timeouts 0}] \
    [list "a non-numeric value is skipped" corner \
        [list "packets_sent_DATA n/a\npackets_sent_DATA 4" $keys] ok \
        {packets_sent_DATA 4 eth1_rx_packets 0 rpc_timeouts 0}] \
    [list "64-bit counters do not overflow" boundary \
        [list "packets_sent_DATA 9223372036854775807\npackets_sent_DATA 1" $keys] ok \
        {packets_sent_DATA 9223372036854775808 eth1_rx_packets 0 rpc_timeouts 0}] \
] {parse snap {*}$input}

testTable delta {
    {"only counters that moved" positive {{a 1 b 2 c 3} {a 1 b 5 c 0}} ok {b 3 c -3}}
    {"nothing moved" boundary {{a 1} {a 1}} ok {}}
    {"a counter missing after counts as 0" corner {{a 4} {}} ok {a -4}}
    {"a counter new after counts from 0" corner {{} {a 4}} ok {a 4}}
} {parse delta {*}$input}

testTable get {
    {"a present counter" positive {{a 3 b 4} b} ok 4}
    {"an absent counter is 0" negative {{a 3} b} ok 0}
    {"empty deltas" boundary {{} b} ok 0}
} {parse get {*}$input}

# ---- cp_node --------------------------------------------------------------------

set cpLine {1 clients: 0.40 Kops/sec, 0.33 Gbps, RTT (us) P50 148.99 P99 26162.00 P99.9 30000.00}

testTable field [list \
    [list "Kops after clients:" positive [list $cpLine clients:] ok 0.40] \
    [list "P99, not P99.9" corner [list $cpLine P99] ok 26162.00] \
    [list "the last word has no value" boundary [list $cpLine 30000.00] ok -] \
    [list "an absent word" negative [list $cpLine P10] ok -] \
    [list "an empty line" boundary [list {} P99] ok -] \
    [list "a caller's placeholder" positive [list {} P99 —] ok —] \
] {parse field {*}$input}

testTable positive {
    {"a positive float" positive 26162.00 ok 1}
    {"zero, as a stalled cp_node prints it" negative 0.00 ok 0}
    {"the smallest positive value" boundary 0.01 ok 1}
    {"a missing field" negative - ok 0}
    {"an empty string" boundary {} ok 0}
    {"a negative number" corner -1 ok 0}
} {parse positive $input}

# The input is {want echoes homa tcp}.
testTable trafficFailures [list \
    [list "everything completed" positive [list 6 6 $cpLine $cpLine] ok {}] \
    [list "echo short of six" negative [list 6 5 $cpLine $cpLine] ok echo] \
    [list "echo timed out (no count)" corner [list 6 {} $cpLine $cpLine] ok echo] \
    [list "Homa and TCP stalled" negative [list 6 6 {P50 0.00 P99 0.00} {}] ok {homa tcp}] \
    [list "everything failed" negative [list 6 0 {} {}] ok {echo homa tcp}] \
    [list "a different echo count is honoured" positive [list 3 3 $cpLine $cpLine] ok {}] \
    [list "more echoes than wanted fails" corner [list 6 7 $cpLine $cpLine] ok echo] \
    [list "want 0 and no echoes passes" boundary [list 0 0 $cpLine $cpLine] ok {}] \
    [list "a non-numeric echo count fails" corner \
        [list 6 {grep: no such file} $cpLine $cpLine] ok echo] \
    [list "a bad want is an error" negative [list x 6 $cpLine $cpLine] error \
        {bad echo count "x"}] \
] {parse trafficFailures {*}$input}

# ---- tc netem ---------------------------------------------------------------------

set tcNetem "qdisc netem 8001: root refcnt 2 limit 100000 loss 5%
 Sent 123456 bytes 96410 pkt (dropped 4559, overlimits 0 requeues 0)
 backlog 0b 0p requeues 0"
set tcHoma "qdisc homa 8006: root refcnt 2
 Sent 999 bytes 77 pkt (dropped 1, overlimits 0 requeues 0)"

testTable netemSent [list \
    [list "packets and drops of the netem qdisc" positive $tcNetem ok {96410 4559}] \
    [list "another qdisc's counters are not netem's" negative $tcHoma ok {}] \
    [list "netem after another qdisc" corner "$tcHoma\n$tcNetem" ok {96410 4559}] \
    [list "a netem line without counters" corner "qdisc netem 8001: root" ok {}] \
    [list "no output" boundary {} ok {}] \
] {parse netemSent $input}

testTable dropRate {
    {"no loss configured, none seen" positive {1000 0 0} ok {rate 0.00 ok 1}}
    {"no loss configured, one drop" negative {1000 1 0} ok {rate 0.10 ok 0}}
    {"1 % configured, 0.76 % seen (GSO)" positive {216477 1662 1} ok {rate 0.76 ok 1}}
    {"exactly the upper bound 2l + 0.5" boundary {975 25 1} ok {rate 2.50 ok 1}}
    {"just over the upper bound" boundary {974 26 1} ok {rate 2.60 ok 0}}
    {"exactly half the loss over 10k packets" boundary {9950 50 1} ok {rate 0.50 ok 1}}
    {"under half the loss over 10k packets" boundary {9951 49 1} ok {rate 0.49 ok 0}}
    {"a small sample needs no lower bound" boundary {9999 0 1} ok {rate 0.00 ok 1}}
    {"no packets at all" corner {0 0 1} ok {rate 0.00 ok 1}}
    {"a fractional loss" positive {326224 187 0.1} ok {rate 0.06 ok 1}}
    {"a non-numeric loss" negative {1000 0 abc} error {not a number: "abc"}}
    {"a negative packet count" negative {-1 0 1} error {not a count: "-1"}}
} {parse dropRate {*}$input}

testTable netemLimitOk {
    {"the limit took" positive
        {{qdisc netem 8001: root refcnt 2 limit 100000 delay 1ms} 100000} ok 1}
    {"the limit at the end of the line" boundary
        {{qdisc netem 8001: root refcnt 2 limit 100000} 100000} ok 1}
    {"tc's default limit" negative
        {{qdisc netem 8001: root refcnt 2 limit 1000 delay 1ms} 100000} ok 0}
    {"a longer limit that starts with ours" corner
        {{qdisc netem 8001: root refcnt 2 limit 1000000} 100000} ok 0}
    {"on a later line" corner
        "{qdisc fq_codel 0: root\nqdisc netem 1: root refcnt 2 limit 100000} 100000" ok 1}
    {"no netem qdisc" negative {{qdisc homa 1: root limit 100000} 100000} ok 0}
    {"empty output" boundary {{} 100000} ok 0}
} {parse netemLimitOk {*}$input}

testTable netemDetail {
    {"the arguments, without tc's prefix" positive
        "qdisc netem 8001: root refcnt 2 limit 100000 delay 1ms seed 17\n" ok
        {limit 100000 delay 1ms seed 17}}
    {"no netem qdisc" negative "qdisc fq_codel 0: root" ok {}}
    {"empty output" boundary {} ok {}}
} {parse netemDetail $input}

tcltest::cleanupTests
